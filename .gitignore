# 忽略备份文件夹（备份留在你本地就好，不要上云）
*_backup/
chroma_db_backup/
docstore_backup/

# 忽略 Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 忽略本地环境变量
.env

# 忽略系统临时文件
.DS_Store
Thumbs.db


# 绝对禁止这 8.9 万个碎片上 Git！
chroma_db/
docstore/

# 也不要传巨大的压缩包到 GitHub (会超 100MB 限制)
*.zip

# 临时备份也不要
*.pkl


# 过滤掉所有原材料和备份数据
Law_Act/archivedrawpdf/
Law_Act/archivedtxt/
Law_Act/rawpdf/
Law_Act/cleantxt/