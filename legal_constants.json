          "min_penalty_amount": 50
        },
        {
          "delay_min_months": 3.01,
          "penalty_percentage": 0.20,
          "min_penalty_amount": 100
        }
      ],
      "calculation_formula_steps": {
        "step_1": "annual_rental = monthly_rental * 12",
        "step_2": "taxable_rental = annual_rental - exemption_amount (Note: exemption is 0 for 2026+)",
        "step_3": "calculation_units = Math.ceil(taxable_rental / 250)",
        "step_4": "base_stamp_duty = calculation_units * rate_per_base_unit",
        "step_5": "total_stamp_duty = base_stamp_duty + (number_of_extra_copies * flat_fee_per_extra_copy)"
      }
    },
